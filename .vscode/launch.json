{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Product Advisor (server)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "Retrieval eval",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval_retrieval.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONIOENCODING": "utf-8" }
    }
  ]
}
